{
  "manifest": "../assets/sample/manifest.json",
  "output": [1920, 1080],
  "fps": 60,
  "bpm": 124,
  "feedback": {"enabled": true, "decay": 0.8, "zoom": 0.996, "spin": 0.2, "mode": 0, "beat_cut": 0.3},
  "global_effects": [
    {"type": "chromatic", "params": {"strength": 0.002}, "bindings": [{"param": "strength", "signal": "uBassEnergy", "amount": 0.006}]}
  ],
  "initial": "anchor",
  "compositions": {
    "anchor": {
      "background": [0, 0, 0, 1],
      "layers": [
        {"kind": "layer", "id": "face", "asset": "news", "rect": [0.1, 0.05, 0.8, 0.8],
         "effects": [{"type": "color_grade", "params": {"saturation": 0.3, "contrast": 1.3}}]},
        {"kind": "annotation", "id": "facebox", "target": "face", "style": "box", "label": "SUBJECT 07"},
        {"kind": "layer", "id": "ticker", "asset": "ticker", "rect": [0.0, 0.9, 1.0, 0.08]}
      ]
    },
    "grid": {
      "background": [0.02, 0.02, 0.02, 1],
      "layers": [
        {"kind": "group", "id": "panels", "rect": [0, 0, 1, 1],
         "effects": [{"type": "glitch", "params": {"amount": 0.01}, "bindings": [{"param": "amount", "signal": "uOnsetEnvelope", "amount": 0.03}]}],
         "children": [
          {"kind": "layer", "id": "c1", "asset": "cam1", "rect": [0.0, 0.0, 0.5, 0.5]},
          {"kind": "layer", "id": "c2", "asset": "cam2", "rect": [0.5, 0.0, 0.5, 0.5]},
          {"kind": "layer", "id": "c3", "asset": "cam3", "rect": [0.0, 0.5, 0.5, 0.5], "effects": [{"type": "edge_detect", "params": {"mix_amount": 0.7}}]},
          {"kind": "layer", "id": "c4", "asset": "cam4", "rect": [0.5, 0.5, 0.5, 0.5]}
         ]},
        {"kind": "layer", "id": "caption", "asset": "caption", "rect": [0.02, 0.02, 0.5, 0.06]}
      ]
    },
    "document": {
      "background": [0, 0, 0, 1],
      "layers": [
        {"kind": "layer", "id": "bg", "asset": "news", "instance": "independent", "start": 3.0,
         "effects": [{"type": "color_grade", "params": {"saturation": 0.0, "contrast": 0.7}}, {"type": "kaleidoscope", "params": {"segments": 4.0}}]},
        {"kind": "group", "id": "doc", "rect": [0.3, 0.08, 0.4, 0.84], "clip": true,
         "children": [
          {"kind": "layer", "id": "page", "asset": "doc_p1", "bindings": [{"prop": "scale", "signal": "uBeatEnvelope", "amount": 0.02}]},
          {"kind": "annotation", "id": "hl", "style": "highlight", "color": [1, 1, 0, 1], "boxes": [[0.1, 0.3, 0.8, 0.05]]},
          {"kind": "annotation", "id": "red", "style": "redact", "boxes": [[0.1, 0.5, 0.6, 0.04], [0.1, 0.56, 0.7, 0.04]]}
         ]},
        {"kind": "layer", "id": "ticker", "asset": "ticker", "rect": [0.0, 0.92, 1.0, 0.08], "blend": "add"}
      ]
    }
  }
}
